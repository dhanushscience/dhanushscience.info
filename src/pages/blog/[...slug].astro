---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Themed from '../../components/Themed.astro';
import { themeImages } from '../../themed';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, cover, coverDark, thumbnail } = post.data;
const body = themeImages(post.rendered?.html ?? '');
const toc = (post.rendered?.metadata?.headings ?? []).filter((h) => h.depth === 2);
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 220));
const share = cover || thumbnail?.light || undefined;
const when = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const postUrl = new URL(`/blog/${post.id}/`, Astro.site).href;
const person = { '@type': 'Person', name: 'Dhanush S.', url: 'https://dhanushscience.info/' };
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting',
    headline: title, description,
    image: new URL(share ?? '/og-default.png', Astro.site).href,
    datePublished: date.toISOString(), dateModified: date.toISOString(),
    author: person, publisher: person, mainEntityOfPage: postUrl,
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dhanushscience.info/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://dhanushscience.info/blog/' },
      { '@type': 'ListItem', position: 3, name: title, item: postUrl },
    ],
  },
];
---
<Base title={`${title} | Dhanush Science`} description={description} active="blog" image={share} type="article" published={date} jsonLd={jsonLd}>
  <details class="reading" slot="bar">
    <summary><span id="now">{title}</span></summary>
    <ol>
      {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      <li><a href="/blog/">← All posts</a></li>
    </ol>
  </details>
  <div class="reader">
  <article>
    <a class="back mono" href="/blog/">← All posts</a>
    <p class="meta mono"><time datetime={date.toISOString()}>{when}</time> · {minutes} min read</p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    {cover && <Themed class="cover" light={cover} dark={coverDark} alt={title} width={1200} height={750} />}
    <div class="prose" set:html={body} />
  </article>
  {toc.length > 1 && (
    <nav class="toc" aria-labelledby="toc-h">
      <p class="mono" id="toc-h">On this page</p>
      <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </nav>
  )}
  </div>
</Base>

<script>
  // phones: the top bar names the section being read
  const box = document.querySelector<HTMLDetailsElement>('.reading')!;
  const now = box.querySelector<HTMLElement>('#now')!;
  const title = now.textContent!;
  const links = [...box.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
  const update = () => {
    let cur: HTMLAnchorElement | undefined;
    for (const a of links) {
      const h = document.getElementById(a.getAttribute('href')!.slice(1));
      if (h && h.getBoundingClientRect().top < 120) cur = a;
    }
    now.textContent = cur?.textContent ?? title;
    links.forEach((a) => (a === cur ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
  };
  addEventListener('scroll', update, { passive: true });
  update();
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!box.contains(t) || t.closest('a')) box.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && box.open) { box.open = false; box.querySelector('summary')!.focus(); }
  });
</script>

<style>
  .reading{order:1;flex:1;min-width:0}
  .reading summary{display:flex;align-items:center;gap:10px;height:40px;padding:0 10px;cursor:pointer;list-style:none;font:500 14px var(--f-sub)}
  .reading summary::-webkit-details-marker{display:none}
  .reading summary span{flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
  .reading summary::after{content:"";flex:none;width:7px;height:7px;border:solid var(--orange);border-width:0 2px 2px 0;transform:translateY(-2px) rotate(45deg)}
  .reading[open] summary::after{transform:translateY(2px) rotate(225deg)}
  .reading ol{position:absolute;top:60px;left:0;right:0;max-height:70vh;overflow-y:auto;list-style:none;padding:8px 18px;background:#000;border-radius:22px;box-shadow:0 0 0 1px rgba(255,255,255,.16),0 24px 40px -16px rgba(0,0,0,.6)}
  .reading li+li{border-top:1px solid rgba(255,255,255,.14)}
  .reading a{display:block;padding:13px 0;font:500 14px/1.4 var(--f-sub);color:rgba(255,255,255,.75);text-decoration:none}
  .reading a[aria-current]{color:var(--orange)}
  :global(.rail:has(.reading) .rail-nav){display:none}
  @media (min-width:900px){
    .reading{display:none}
    :global(.rail:has(.reading) .rail-nav){display:flex}
  }
  /* centred reading column; wide screens add the contents list beside it */
  :global(.wrap.page:has(.reader)){max-width:none}
  .reader{display:grid;grid-template-columns:minmax(0,720px);justify-content:center;column-gap:clamp(40px,5vw,88px)}
  .toc{display:none}
  @media (min-width:1200px){
    .reader{grid-template-columns:minmax(0,720px) 260px}
    .toc{display:block;position:sticky;top:40px;align-self:start;max-height:calc(100vh - 80px);overflow-y:auto;margin-top:64px}
  }
  .toc p{color:var(--muted);padding-bottom:12px;border-bottom:1px solid var(--ink)}
  .toc ol{list-style:none;padding:0}
  .toc a{display:block;padding:11px 0;border-bottom:1px solid var(--rule);font:500 14px/1.4 var(--f-sub);text-decoration:none;color:var(--muted)}
  .toc a:hover{color:var(--orange)}
  .back{display:inline-block;color:var(--muted);text-decoration:none;margin-bottom:24px}
  .back:hover{color:var(--orange)}
  .meta{color:var(--orange);margin-bottom:14px}
  h1{font:800 clamp(28px,3.6vw,46px)/1.08 var(--f-display);letter-spacing:-.02em;margin-bottom:16px}
  .lead{font:400 clamp(18px,1.6vw,21px)/1.5 var(--f-sub);color:var(--muted);margin-bottom:32px;padding-bottom:28px;border-bottom:1px solid var(--rule)}
  article :global(.cover){width:100%;border-radius:2px;margin-bottom:32px}
  .prose{font-size:clamp(17px,1.3vw,18.5px);line-height:1.75;overflow-wrap:break-word}
  .prose :global(> * + *){margin-top:1.2em}
  .prose :global(h2){font:700 clamp(22px,2vw,27px)/1.25 var(--f-sub);letter-spacing:-.01em;margin-top:2.2em}
  .prose :global(h3){font:600 20px/1.3 var(--f-sub);margin-top:1.8em}
  .prose :global(a){color:var(--orange);text-underline-offset:3px}
  .prose :global(img){border-radius:2px;margin:1.8em auto}
  .prose :global(ul),.prose :global(ol){padding-left:1.4em}
  .prose :global(li + li){margin-top:.5em}
  .prose :global(li)::marker{color:var(--orange)}
  .prose :global(blockquote){background:var(--tint);border:1px solid var(--rule);border-radius:2px;padding:22px clamp(18px,3vw,30px)}
  .prose :global(blockquote > * + *){margin-top:.8em}
  .prose :global(code){font:500 .88em var(--f-mono);background:var(--pink);padding:.15em .4em;border-radius:2px}
  .prose :global(pre){background:#0b0b0b;color:#f4f2ef;padding:20px;border-radius:2px;overflow-x:auto;font-size:15px}
  .prose :global(pre code){background:none;padding:0}
  .prose :global(table){display:block;overflow-x:auto;border-collapse:collapse}
  .prose :global(th),.prose :global(td){border:1px solid var(--rule);padding:8px 12px;text-align:left}
  .prose :global(hr){border:0;border-top:1px solid var(--line);margin-block:2.4em}
</style>
