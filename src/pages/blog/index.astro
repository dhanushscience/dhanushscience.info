---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog | Dhanush Science" description="Notes and write-ups on embedded systems, AI, connected devices and building Project OASIS." active="blog" jsonLd={[{
  '@context': 'https://schema.org', '@type': 'Blog', name: 'Dhanush Science Blog', url: 'https://dhanushscience.info/blog/',
  author: { '@type': 'Person', name: 'Dhanush S.', url: 'https://dhanushscience.info/' },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `https://dhanushscience.info/blog/${p.id}/`, datePublished: p.data.date.toISOString() })),
}]}>
  <header class="head">
    <p class="mono kicker"><i></i>Blog</p>
    <h1>Notes from the bench</h1>
    <label class="search">
      <span class="sr">Search posts</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder="Search posts" autocomplete="off">
    </label>
  </header>

  <ul class="grid" id="grid">
    {posts.map((p) => (
      <li data-t={`${p.data.title} ${p.data.description}`.toLowerCase()}>
        <a class="post" href={`/blog/${p.id}/`}>
          <div class="thumb">{p.data.cover ? <img src={p.data.cover} alt="" loading="lazy" width="800" height="500"> : <span class="dot"></span>}</div>
          <time class="mono" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <h2>{p.data.title}</h2>
          <p>{p.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
  <p class="none" id="none" hidden>No posts match that search.</p>
  {posts.length === 0 && <p class="none">First post coming soon.</p>}
</Base>

<script>
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const items = [...document.querySelectorAll<HTMLElement>('#grid li')];
  const none = document.querySelector<HTMLElement>('#none')!;
  q.addEventListener('input', () => {
    const v = q.value.trim().toLowerCase();
    let n = 0;
    items.forEach((li) => { const hit = li.dataset.t!.includes(v); li.hidden = !hit; if (hit) n++; });
    none.hidden = n > 0 || items.length === 0;
  });
</script>

<style>
  .head{margin-bottom:clamp(24px,3vw,36px)}
  .kicker{display:flex;align-items:center;gap:12px;color:var(--orange);margin-bottom:12px}
  .kicker i{width:48px;height:1px;background:var(--line)}
  h1{font:800 clamp(24px,3vw,36px)/1.05 var(--f-display);letter-spacing:-.02em;margin-bottom:20px}
  .search{position:relative;display:block;max-width:360px}
  .search svg{position:absolute;left:16px;top:50%;width:17px;height:17px;transform:translateY(-50%);color:var(--muted)}
  .search input{width:100%;height:44px;border-radius:999px;border:0;background:var(--card);color:var(--ink);font:400 15px var(--f-sub);padding:0 18px 0 42px;box-shadow:inset 0 0 0 1.5px var(--line)}
  .search input:focus{outline:0;box-shadow:inset 0 0 0 2px var(--orange)}
  .grid{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));gap:clamp(14px,1.6vw,20px)}
  .grid li[hidden]{display:none}
  .post{display:block;height:100%;text-decoration:none;background:var(--card);border-radius:16px;padding:10px 10px 18px;border:1px solid var(--rule);transition:transform .35s cubic-bezier(.2,.8,.2,1),border-color .25s}
  .post:hover{transform:translateY(-3px);border-color:var(--orange)}
  .thumb{aspect-ratio:16/10;border-radius:12px;overflow:hidden;background:var(--pink);display:grid;place-items:center;margin-bottom:12px}
  .thumb img{width:100%;height:100%;object-fit:cover}
  .dot{width:18%;aspect-ratio:1;border-radius:50%;background:var(--orange)}
  time{display:block;color:var(--muted);padding-inline:6px;font-size:11px}
  h2{font:600 17px/1.25 var(--f-sub);letter-spacing:-.01em;margin:6px 6px 4px}
  .post p{color:var(--muted);font-size:14px;line-height:1.5;margin-inline:6px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .none{color:var(--muted);margin-top:24px}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>
