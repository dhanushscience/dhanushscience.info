---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Dhanush Science" description="This page does not exist." noindex>
  <p class="mono" style="color:var(--orange)">404</p>
  <h1 style="font:800 clamp(28px,4vw,48px)/1 var(--f-display);text-transform:uppercase;margin:12px 0 18px">Page not found</h1>
  <p style="color:var(--muted);margin-bottom:24px">That page doesn't exist or has moved.</p>
  <a class="btn hot" href="/">Back to home</a>
</Base>
